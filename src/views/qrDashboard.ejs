<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500;700&display=swap"
    rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/images/icon.png" />
  <link rel="stylesheet" href="/css/pages/dashboard.css" />
  <link rel="stylesheet" href="/css/pages/qrEditor.css" />
  <script type="module" src="/js/main.js"></script>

  <title>QR Codes — Dashboard</title>
</head>

<body>
  <div class="dashboard-container">
    <!-- Header -->
    <header class="dashboard-header">
      <div>
        <h1>QR Codes</h1>
        <small>Welcome back, <strong>
            <%= name %>
          </strong> — manage your QR codes here</small>
      </div>

      <div style="display:flex; gap:10px; align-items:center;">
        <a href="/dashboard" class="pagination-btn nav" style="text-decoration:none;"><i class="ri-links-line"></i>
          Links</a>
        <a href="/analytics" class="pagination-btn nav" style="text-decoration:none;"><i class="ri-line-chart-line"></i>
          Analytics</a>
        <form action="/auth/logout" method="POST">
          <button class="logout-btn" type="submit"><i class="ri-logout-box-r-line"></i> Logout</button>
        </form>
      </div>
    </header>

    <!-- error message -->
    <% if (error) { %>
      <p class="error">
        <%= error %>
      </p>
      <% } %>

        <form class="url-form" id="standaloneQrForm">
          <label for="qrDestinationUrl">Destination URL</label>
          <input id="qrDestinationUrl" name="destinationURL" type="text"
            placeholder="example.com or https://example.com" required />

          <label for="qrTitle">Title (Optional)</label>
          <input id="qrTitle" name="title" type="text" maxlength="100" placeholder="e.g. Portfolio Site" />

          <div class="form-group">
            <label for="expiration">Expiration</label>
            <select id="expiration" name="expiration">
              <option value="never" selected>Never</option>
              <option value="1d">1 Day</option>
              <option value="7d">7 Days</option>
              <option value="30d">30 Days</option>
              <option value="90d">90 Days</option>
              <option value="custom">Custom Date</option>
            </select>
          </div>

          <div class="form-group" id="customDateWrapper" style="display: none">
            <label for="customExpiry">Expiry Date</label>
            <input type="datetime-local" id="customExpiry" name="customExpiry"
              min="<%= new Date().toISOString().slice(0,16) %>" />
          </div>

          <button type="button" id="toggleDesignBtn" class="pagination-btn nav"
            style="align-self: center; margin-top: 8px;">
            <i class="ri-palette-line"></i> Customize Design (Optional)
          </button>

          <div id="standaloneDesignSection" style="display: none; margin-top: 16px;">
            <div class="design-row">
              <div class="color-field">
                <label>Foreground</label>
                <div class="color-input-row">
                  <input type="color" id="sqFgColorPicker" value="#000000" class="color-swatch-input" />
                  <input type="text" id="sqFgColorHex" value="#000000" class="color-hex-input" maxlength="7" />
                </div>
              </div>

              <div class="color-field">
                <label>Background</label>
                <div class="color-input-row">
                  <input type="color" id="sqBgColorPicker" value="#ffffff" class="color-swatch-input" />
                  <input type="text" id="sqBgColorHex" value="#ffffff" class="color-hex-input" maxlength="7" />
                </div>
              </div>
            </div>

            <div class="design-field">
              <label>Pattern</label>
              <div class="option-card-grid" id="sqDotStyleGroup">
                <button type="button" class="option-card selected" data-value="square">
                  <svg viewBox="0 0 40 40">
                    <g fill="currentColor">
                      <rect x="2" y="2" width="8" height="8" />
                      <rect x="14" y="2" width="8" height="8" />
                      <rect x="26" y="2" width="8" height="8" />
                      <rect x="2" y="14" width="8" height="8" />
                      <rect x="26" y="14" width="8" height="8" />
                      <rect x="2" y="26" width="8" height="8" />
                      <rect x="14" y="26" width="8" height="8" />
                      <rect x="26" y="26" width="8" height="8" />
                    </g>
                  </svg>
                  <span>Square</span>
                </button>
                <button type="button" class="option-card" data-value="rounded">
                  <svg viewBox="0 0 40 40">
                    <g fill="currentColor">
                      <rect x="2" y="2" width="8" height="8" rx="2.5" />
                      <rect x="14" y="2" width="8" height="8" rx="2.5" />
                      <rect x="26" y="2" width="8" height="8" rx="2.5" />
                      <rect x="2" y="14" width="8" height="8" rx="2.5" />
                      <rect x="26" y="14" width="8" height="8" rx="2.5" />
                      <rect x="2" y="26" width="8" height="8" rx="2.5" />
                      <rect x="14" y="26" width="8" height="8" rx="2.5" />
                      <rect x="26" y="26" width="8" height="8" rx="2.5" />
                    </g>
                  </svg>
                  <span>Rounded</span>
                </button>
                <button type="button" class="option-card" data-value="dots">
                  <svg viewBox="0 0 40 40">
                    <g fill="currentColor">
                      <circle cx="6" cy="6" r="4" />
                      <circle cx="18" cy="6" r="4" />
                      <circle cx="30" cy="6" r="4" />
                      <circle cx="6" cy="18" r="4" />
                      <circle cx="30" cy="18" r="4" />
                      <circle cx="6" cy="30" r="4" />
                      <circle cx="18" cy="30" r="4" />
                      <circle cx="30" cy="30" r="4" />
                    </g>
                  </svg>
                  <span>Dots</span>
                </button>
              </div>
            </div>

            <div class="design-field">
              <label>Frame Shape</label>
              <div class="option-card-grid frame-shape-grid" id="sqFrameShapeGroup">
                <button type="button" class="option-card selected" data-value="sharp">
                  <svg viewBox="0 0 40 40">
                    <rect x="3" y="3" width="34" height="34" fill="none" stroke="currentColor" stroke-width="3" />
                  </svg>
                  <span>Sharp</span>
                </button>
                <button type="button" class="option-card" data-value="round">
                  <svg viewBox="0 0 40 40">
                    <rect x="3" y="3" width="34" height="34" rx="10" fill="none" stroke="currentColor"
                      stroke-width="3" />
                  </svg>
                  <span>Round</span>
                </button>
              </div>
            </div>
          </div>

          <button type="submit" id="generateQrBtn"><i class="ri-qr-code-line"></i> Generate QR Code</button>
        </form>

        <h2>My QR Codes</h2>

        <!-- Search / Filter toolbar -->
        <% const hasActiveFilters=(filters.status && filters.status !=="all" ) || (filters.expiry && filters.expiry
          !=="all" ) || (filters.linked && filters.linked !=="all" ) || (filters.sortBy && filters.sortBy !=="newest" );
          %>

          <form class="url-toolbar" method="GET" action="/qr" id="qrToolbarForm">
            <div class="search-input-wrap">
              <i class="ri-search-line search-icon"></i>
              <input type="text" name="search" id="qrSearchInput" placeholder="Search QR"
                value="<%= filters.search || '' %>" autocomplete="off" />
              <button type="button" class="clear-search-btn <%= filters.search ? '' : 'is-hidden' %>"
                id="clearQrSearchBtn">
                <i class="ri-close-line"></i>
              </button>
            </div>

            <button type="button" class="filter-trigger-btn" id="qrFilterTriggerBtn">
              <i class="ri-equalizer-3-line"></i>
              <% if (hasActiveFilters) { %>
                <span class="filter-badge-dot"></span>
                <% } %>
            </button>
          </form>

          <!-- BULK DELETE -->
          <div id="bulkActionBar" class="bulk-action-bar" style="display:none;">
            <label class="bulk-select-all-label">
              <input type="checkbox" id="selectAllCheckbox" /> 
              <span id="selectAllLabel">Select all</span>
            </label>
            <span id="bulkSelectedCount">0 selected</span>
            <button type="button" id="bulkDeleteBtn" class="danger">
              <i class="ri-delete-bin-line"></i> Delete Selected
            </button>
          </div>

          <!-- QR GRID -->
          <section class="table-section">
            <% if (qrs && qrs.length> 0) { %>

              <div class="qr-grid" data-focus-id="<%= focusId || '' %>">
                <% qrs.forEach((qr)=> { %>
                  <div class="qr-card" data-qrid="<%= qr.qrId %>">
                    <input type="checkbox" class="row-select-checkbox qr-card-checkbox" data-shortid="<%= qr.qrId %>" />

                    <!-- thumbnail -->
                    <div class="qr-thumb">
                      <% if (qr.qrStatus==="READY" && qr.imageUrl) { %>
                        <div class="qr-thumb-clickable" data-qrid="<%= qr.qrId %>">
                          <img src="<%= qr.imageUrl %>" alt="<%= qr.title %> QR code" />
                        </div>
                        <% } else if (qr.qrStatus==="FAILED" ) { %>
                          <span class="pending"><i class="ri-error-warning-line"></i><br />Failed</span>
                          <% } else { %>
                            <span class="pending"><i class="ri-loader-4-line"></i><br />Generating…</span>
                            <% } %>
                    </div>

                    <!-- body -->
                    <div class="qr-card-body">
                      <div class="qr-badges">
                        <span class="qr-badge"><i class="ri-qr-code-line"></i> QR Code</span>
                        <% if (qr.linkedUrlId) { %>
                          <span class="qr-badge linked"><i class="ri-link"></i> Linked</span>
                          <% } %>
                            <span class="qr-badge id" data-qrid-label><i class="ri-key-2-line"></i>
                              <%= qr.qrId %>
                            </span>
                      </div>

                      <div class="qr-title" title="<%= qr.title %>">
                        <%= qr.title %>
                      </div>


                      <div class="qr-destination" title="<%= qr.destinationURL %>">
                        <i class="ri-arrow-right-up-line"></i>
                        <a href="<%= qr.destinationURL %>" target="_blank" class="redirect-link"
                          title="<%= qr.destinationURL %>">
                          <%= qr.destinationURL %>
                        </a>
                      </div>

                      <% if (qr.linkedShortId) { %>
                        <span class="qr-meta-pill">
                          <i class="ri-link"></i>
                          <a href="<%= baseUrl %>/url/<%= qr.linkedShortId %>" target="_blank" class="redirect-link">
                            <%= baseUrl %>/url/<%= qr.linkedShortId %>
                          </a>
                        </span>
                        <% } %>

                          <div class="qr-meta-row">
                            <span class="status-badge status-<%= qr.status %>">
                              <%= qr.status.charAt(0).toUpperCase() + qr.status.slice(1) %>
                            </span>


                            <span class="qr-meta-pill scans">
                              <i class="ri-scan-2-line"></i>
                              <%= qr.totalScans || 0 %> scans
                            </span>

                            <span class="qr-meta-pill"
                              title="<%= qr.expiresAt ? new Date(qr.expiresAt).toLocaleString('en-IN') : 'Never expires' %>">
                              <i class="ri-time-line"></i>
                              Expires: <%= qr.expiresAt ? new Date(qr.expiresAt).toLocaleDateString('en-IN', {
                                day: 'numeric' , month: 'short' , year: 'numeric' }) : 'Never' %>
                            </span>

                            <span class="qr-meta-pill" title="<%= new Date(qr.createdAt).toLocaleString('en-IN') %>">
                              <i class="ri-calendar-line"></i>
                              Created: <%= new Date(qr.createdAt).toLocaleDateString('en-IN', { day: 'numeric' ,
                                month: 'short' , year: 'numeric' }) %>
                            </span>
                          </div>

                          <!-- download + share -->
                          <div class="qr-card-footer">
                            <div class="qr-download-wrap">
                              <button class="qr-icon-btn qr-download-trigger" type="button" title="Download">
                                <i class="ri-download-2-line"></i>
                              </button>
                              <div class="qr-download-menu">
                                <button class="qr-download-option" data-format="png"
                                  data-qrid="<%= qr.qrId %>">PNG</button>
                                <button class="qr-download-option" data-format="jpeg"
                                  data-qrid="<%= qr.qrId %>">JPEG</button>
                                <button class="qr-download-option" data-format="svg"
                                  data-qrid="<%= qr.qrId %>">SVG</button>
                                <button class="qr-download-option" data-format="pdf"
                                  data-qrid="<%= qr.qrId %>">PDF</button>
                              </div>
                            </div>

                            <button class="qr-icon-btn qr-share-btn" type="button" title="Share"
                              data-qrid="<%= qr.qrId %>">
                              <i class="ri-share-line"></i>
                            </button>
                          </div>
                    </div>

                    <!-- 3-dot action menu -->
                    <div class="action-dropdown">
                      <button class="action-btn" type="button">
                        <i class="ri-more-2-fill"></i>
                      </button>

                      <div class="action-menu">

                        <button class="qr-analytics-btn" data-qrid="<%= qr.qrId %>">
                          <i class="ri-line-chart-line"></i>
                          Analytics
                        </button>

                        <button class="edit-qr-btn" data-qrid="<%= qr.qrId %>">
                          <i class="ri-edit-line"></i>
                          Edit QR
                        </button>

                        <% if (qr.linkedUrlId) { %>
                          <button class="link-details-btn" data-shortid="<%= qr.linkedShortId %>">
                            <i class="ri-external-link-line"></i>
                            Show Link
                          </button>
                          <% } %>

                            <% if (!qr.linkedUrlId) { %>
                              <button class="create-short-link-btn" data-qrid="<%= qr.qrId %>">
                                <i class="ri-links-line"></i>
                                Create Short Link
                              </button>
                              <% } %>

                                <hr />

                                <button class="qr-disable-btn disable-btn" data-qrid="<%= qr.qrId %>"
                                  data-disabled="<%= qr.isDisabled %>" data-linked="<%= Boolean(qr.linkedUrlId) %>">
                                  <i class="ri-forbid-line"></i>
                                  <%= qr.isDisabled ? "Enable" : "Disable" %>
                                </button>

                                <hr />

                                <button class="qr-delete-btn danger" data-qrid="<%= qr.qrId %>"
                                  data-linked="<%= Boolean(qr.linkedUrlId) %>">
                                  <i class="ri-delete-bin-line"></i>
                                  Delete
                                </button>
                      </div>
                    </div>

                  </div>
                  <% }) %>
              </div>

              <!-- count -->
              <div class="table-header">
                <span>Showing <%= startIndex %>–<%= endIndex %> of <%= total %> QR codes</span>
              </div>

              <!-- PAGINATION -->
              <% const buildPageUrl=(pageNum)=> {
                const params = new URLSearchParams();
                if (filters.search) params.set('search', filters.search);
                if (filters.status && filters.status !== 'all') params.set('status', filters.status);
                if (filters.expiry && filters.expiry !== 'all') params.set('expiry', filters.expiry);
                if (filters.linked && filters.linked !== 'all') params.set('linked', filters.linked);
                if (filters.sortBy && filters.sortBy !== 'newest') params.set('sortBy', filters.sortBy);
                params.set('page', pageNum);
                return `/qr?${params.toString()}`;
                }; %>

                <% if (totalPages> 1) { %>
                  <div class="pagination">
                    <% if (currentPage> 1) { %>
                      <a href="<%= buildPageUrl(currentPage - 1) %>" class="pagination-btn nav">← Prev</a>
                      <% } else { %>
                        <span class="pagination-btn nav disabled">← Prev</span>
                        <% } %>

                          <% const pages=new Set(); pages.add(1); pages.add(totalPages); for (let i=Math.max(1,
                            currentPage - 1); i <=Math.min(totalPages, currentPage + 1); i++) { pages.add(i); } const
                            sorted=[...pages].sort((a, b)=> a - b);
                            let prev = 0;
                            for (const pg of sorted) {
                            if (pg - prev > 1) { %>
                            <span class="pagination-dots">···</span>
                            <% } %>
                              <a href="<%= buildPageUrl(pg) %>"
                                class="pagination-btn <%= currentPage === pg ? 'active' : '' %>">
                                <%= pg %>
                              </a>
                              <% prev=pg; } %>

                                <% if (currentPage < totalPages) { %>
                                  <a href="<%= buildPageUrl(currentPage + 1) %>" class="pagination-btn nav">Next →</a>
                                  <% } else { %>
                                    <span class="pagination-btn nav disabled">Next →</span>
                                    <% } %>
                  </div>
                  <% } %>

                    <% } else { %>

                      <div class="empty-state">
                        <% if (hasActiveFilters) { %>
                          <i class="ri-search-line"></i>
                          <h3>No results found</h3>
                          <p>No QR codes match the selected filters. Try adjusting or resetting them.</p>
                          <% } else { %>
                            <i class="ri-qr-code-line"></i>
                            <h3>No QR codes yet</h3>
                            <p>Create one from a link's action menu, or generate a standalone QR code.</p>
                            <% } %>
                      </div>

                      <% } %>
          </section>
  </div>

  <!-- FILTER MODAL -->
  <div id="qrFilterModal" class="modal">
    <div class="modal-content modal-content--filter">
      <span class="close" data-close-modal>&times;</span>

      <div class="filter-content-header">
        <h3>Filters</h3>
      </div>

      <div class="filter-group">
        <label for="qrStatusSelect">Status</label>
        <select name="status" id="qrStatusSelect" form="qrToolbarForm">
          <option value="all" <%=filters.status==="all" ? "selected" : "" %>>All Status</option>
          <option value="active" <%=filters.status==="active" ? "selected" : "" %>>Active</option>
          <option value="disabled" <%=filters.status==="disabled" ? "selected" : "" %>>Disabled</option>
          <option value="expired" <%=filters.status==="expired" ? "selected" : "" %>>Expired</option>
        </select>
      </div>

      <div class="filter-group">
        <label>Expiry</label>
        <div class="radio-group">
          <label class="radio-option">
            <input type="radio" name="expiry" value="all" form="qrToolbarForm" <%=(!filters.expiry ||
              filters.expiry==="all" ) ? "checked" : "" %> />
            <span>All</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="expiry" value="set" form="qrToolbarForm" <%=filters.expiry==="set" ? "checked"
              : "" %> />
            <span>Expiring</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="expiry" value="never" form="qrToolbarForm" <%=filters.expiry==="never" ? "checked"
              : "" %> />
            <span>No expiration</span>
          </label>
        </div>
      </div>

      <div class="filter-group">
        <label>Linked</label>
        <div class="radio-group">
          <label class="radio-option">
            <input type="radio" name="linked" value="all" form="qrToolbarForm" <%=(!filters.linked ||
              filters.linked==="all" ) ? "checked" : "" %> />
            <span>All</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="linked" value="linked" form="qrToolbarForm" <%=filters.linked==="linked"
              ? "checked" : "" %> />
            <span>Linked</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="linked" value="standalone" form="qrToolbarForm" <%=filters.linked==="standalone"
              ? "checked" : "" %> />
            <span>Standalone</span>
          </label>
        </div>
      </div>

      <div class="filter-group">
        <label>Sort by</label>
        <select name="sortBy" id="qrSortBySelect" form="qrToolbarForm">
          <option value="newest" <%=(!filters.sortBy || filters.sortBy==="newest" ) ? "selected" : "" %>>Newest first
          </option>
          <option value="oldest" <%=filters.sortBy==="oldest" ? "selected" : "" %>>Oldest first</option>
          <option value="mostScanned" <%=filters.sortBy==="mostScanned" ? "selected" : "" %>>Most scanned</option>
          <option value="leastScanned" <%=filters.sortBy==="leastScanned" ? "selected" : "" %>>Least scanned</option>
        </select>
      </div>

      <div class="filter-content-footer">
        <button type="button" class="clear-filters-btn" id="clearAllQrFiltersBtn">Clear all filters</button>
        <button type="submit" class="apply-filters-btn" form="qrToolbarForm">Apply Filters</button>
      </div>
    </div>
  </div>

  <!-- DELETE MODAL  -->
  <div id="qrDeleteModal" class="modal">
    <div class="modal-content modal-content--delete">
      <h3 id="qrDeleteTitle">Delete QR Code?</h3>
      <p id="qrDeleteMessage"></p>
      <div class="delete-actions">
        <button id="qrCancelDeleteBtn" data-close-modal type="button">Cancel</button>
        <button id="qrConfirmDeleteBtn" type="button" class="danger">Delete</button>
      </div>
    </div>
  </div>

  <!-- DISABLE MODAL -->
  <div id="qrDisableModal" class="modal">
    <div class="modal-content modal-content--delete">
      <h3 "id=" qrDisableTitle">Disable QR Code?</h3>
      <p id="qrDisableMessage"></p>
      <div class="delete-actions">
        <button id="qrCancelDisableBtn" data-close-modal type="button">Cancel</button>
        <button id="qrConfirmDisableBtn" type="button">Confirm</button>
      </div>
    </div>
  </div>

  <!-- QR Preview Modal -->
  <div id="qrPreviewModal" class="modal">
    <div class="modal-content modal-content--qr">
      <span class="close" data-close-modal>&times;</span>
      <h3 style="color: black;">QR Code</h3>
      <img id="qrPreviewImage" src="" style="max-width: 260px;" />
    </div>
  </div>

  <!-- SHORT LINK GENERATED MODAL -->
  <div id="createShortLinkModal" class="modal">
    <div class="modal-content modal-content--link">
      <span class="close" data-close-modal>&times;</span>
      <h3 class="link-modal">Short Link Created</h3>

      <div class="created-link-pill-row">
        <span class="created-link-pill">
          <i class="ri-link"></i>
          <span id="createdShortLinkUrl"></span>
        </span>
        <button class="created-link-copy-btn copy-btn" id="copyCreatedShortLinkBtn" title="Copy">
          <i class="ri-file-copy-line"></i>
        </button>
      </div>

      <div class="created-link-destination-row">
        <i class="ri-arrow-right-up-line"></i>
        <span id="createdShortLinkDestination"></span>
      </div>

      <button id="shareCreatedShortLink" class="share-full-btn">
        <i class="ri-share-line"></i>
      </button>
    </div>
  </div>

  <!-- RESULT MODAL -->
  <div id="standaloneQrModal" class="modal">
    <div class="modal-content modal-content--qr">
      <span class="close" data-close-modal>&times;</span>
      <h3>QR Code Created</h3>

      <div class="qr-loading-state" id="standaloneQrLoadingState">
        <div id="standaloneQrLoader" class="dots-loader">
          <span></span><span></span><span></span>
        </div>
        <p class="dots-loader-label" id="standaloneQrLoaderLabel">Generating your QR code…</p>
      </div>
      <img id="standaloneQrImage" src="" style="max-width: 220px; display: none;" />

      <div class="created-destination-row" id="standaloneQrDestinationRow" style="display: none;">
        <i class="ri-arrow-right-up-line"></i>
        <span id="standaloneQrDestination"></span>
      </div>

      <button id="shareStandaloneQR" class="share-full-btn" style="display: none;">
        <i class="ri-share-line"></i>
      </button>
    </div>
  </div>

  <!-- BULK DELETE MODAL -->
  <div id="bulkDeleteModal" class="modal">
  <div class="modal-content modal-content--delete">
    <h3>Delete Selected Items?</h3>
    <p id="bulkDeleteMessage"></p>
    <div class="delete-actions">
      <button id="cancelBulkDeleteBtn" data-close-modal type="button">Cancel</button>
      <button id="confirmBulkDeleteBtn" type="button" class="danger">Delete</button>
    </div>
  </div>
</div>

</body>

