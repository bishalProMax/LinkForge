<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/pages/verification.css" />
    <link rel="icon" type="image/png" href="/images/icon.png" />
    <title>Account Banned</title>
  </head>

  <body>
    <div class="verification-container">
      <div class="verification-box">
        <div class="status-icon error">✕</div>
        <h1 class="error-text">Account Suspended</h1>
        <p class="verification-message">
          Your LinkForge account has been suspended due to a violation of our
          Terms of Service. If you believe this is a mistake, contact support
          and we'll review your case.
        </p>
        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=support@linkforge.com" target="_blank" class="verification-btn">
          Contact Support
        </a>
      </div>
    </div>
  </body>
</html>