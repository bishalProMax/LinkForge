<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500;700&display=swap"
    rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/images/icon.png" />
  <link rel="stylesheet" href="/css/pages/dashboard.css" />
  <script type="module" src="/js/main.js"></script>

  <title>Dashboard</title>
</head>

<body data-base-url="<%= baseUrl %>" data-created-short-id="<%= shortId || '' %>">
  <div class="dashboard-container">
    <!-- Header -->
    <header class="dashboard-header">
      <div>
        <h1>Dashboard</h1>
        <small>Welcome back, <strong>
            <%= name %>
          </strong> — here's your link overview</small>
      </div>

      <div style="display: flex; gap: 10px; align-items: center;">
        <a href="/analytics" class="pagination-btn nav" style="text-decoration: none;">
          <i class="ri-line-chart-line"></i> Analytics
        </a>
        <a href="/qr" class="pagination-btn nav" style="text-decoration: none;">
          <i class="ri-qr-code-line"></i> QR Codes
        </a>
        <a href="#" id="openBulkUploadBtn" class="pagination-btn nav" style="text-decoration:none;">
          <i class="ri-upload-2-line"></i> Bulk Create
        </a>

        <!-- logout -->
        <form action="/auth/logout" method="POST">
          <button class="logout-btn" type="submit"><i class="ri-logout-box-r-line"></i> Logout</button>
        </form>
      </div>
    </header>

    <!-- Create URL -->
    <form class="url-form" action="/url/generate" method="POST">
      <label for="url">Destination URL</label>
      <input id="url" name="url" type="text" placeholder="example.com or https://example.com" required />

      <label for="customAlias">Custom Alias (Optional)</label>
      <input id="customAlias" name="customAlias" type="text" minlength="3" maxlength="50"
        placeholder="e.g. portfolio" />
      <small> Leave blank to auto-generate. </small>

      <label for="title">Title (Optional)</label>
      <input id="title" type="text" name="title" maxlength="100" placeholder="e.g. Portfolio Site" />

      <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
        <input type="checkbox" id="createQr" name="createQr" style="width: auto; height: auto;" />
        <label for="createQr" style="margin-bottom: 0; font-size: 15px;">Also create a QR code for this link</label>
      </div>

      <div class="form-group">
        <label for="expiration">Expiration</label>

        <select id="expiration" name="expiration">
          <option value="never" selected>Never</option>
          <option value="1d">1 Day</option>
          <option value="7d">7 Days</option>
          <option value="30d">30 Days</option>
          <option value="90d">90 Days</option>
          <option value="custom">Custom Date</option>
        </select>
      </div>

      <div class="form-group" id="customDateWrapper" style="display: none">
        <label for="customExpiry">Expiry Date</label>
        <input type="datetime-local" id="customExpiry" name="customExpiry"
          min="<%= new Date().toISOString().slice(0,16) %>" />
      </div>

      <button type="submit"><i class="ri-links-line"></i> Generate Short URL</button>
    </form>

    <!-- error message -->
    <% if(error){ %>
      <p class="error">
        <%= error %>
      </p>
      <% } %>

        <h2>My Links</h2>
        <!-- Search Form -->
        <% const todayStr=new Date().toISOString().split('T')[0]; %>
          <% const hasActiveFilters=(filters.status && filters.status !=="all" ) || filters.createdFrom ||
            filters.createdTo || (filters.expiry && filters.expiry !=="all" ) || (filters.sortBy && filters.sortBy
            !=="newest" ); %>

            <form class="url-toolbar" method="GET" action="/dashboard" id="urlToolbarForm">
              <div class="search-input-wrap">
                <i class="ri-search-line search-icon"></i>
                <input type="text" name="search" id="searchInput" placeholder="Search Links"
                  value="<%= filters.search || '' %>" autocomplete="off" />
                <button type="button" class="clear-search-btn <%= filters.search ? '' : 'is-hidden' %>"
                  id="clearSearchBtn">
                  <i class="ri-close-line"></i>
                </button>
              </div>

              <button type="button" class="filter-trigger-btn" id="filterTriggerBtn">
                <i class="ri-equalizer-3-line"></i>
                <% if (hasActiveFilters) { %>
                  <span class="filter-badge-dot" id="filterBadgeDot"></span>
                  <% } %>
              </button>
            </form>

            <!-- BULK DELETE -->
            <div id="bulkActionBar" class="bulk-action-bar" style="display:none;">
              <label class="bulk-select-all-label">
                <input type="checkbox" id="selectAllCheckbox" />
                <span id="selectAllLabel">Select all</span>
              </label>

              <span id="bulkSelectedCount">0 selected</span>

              <button type="button" id="bulkDeleteBtn" class="danger">
                <i class="ri-delete-bin-line"></i>
                Delete Selected
              </button>
            </div>

            <!-- table section -->
            <section class="table-section">
              <% if(urls && urls.length>0){ %>

                <div class="table-wrapper" data-focus-id="<%= focusId || '' %>">
                  <table>
                    <thead>
                      <tr>
                        <th></th>
                        <th>Title</th>
                        <th>Short Link</th>
                        <th>Destination URL</th>
                        <th>Status</th>
                        <th>Clicks</th>
                        <th>Created</th>
                        <th>Expiry</th>
                        <th>Actions</th>
                      </tr>
                    </thead>

                    <tbody>
                      <% urls.forEach((url)=> { %>
                        <tr data-shortid="<%= url.shortId %>">
                          <td><input type="checkbox" class="row-select-checkbox" data-shortid="<%= url.shortId %>" />
                          </td>
                          <!-- Title -->
                          <td class="title-cell" title="<%= url.title %>">
                            <%= url.title %>
                          </td>

                          <!-- Short Link -->
                          <td class="short-link-cell">
                            <a href="/url/<%= url.shortId %>" target="_blank" class="short-link">
                              <%= `${baseUrl}/url/${url.shortId}` %>
                            </a>
                          </td>

                          <!-- Destination -->
                          <td class="destination-cell">
                            <a href="<%= url.redirectURL %>" target="_blank" class="redirect-link"
                              title="<%= url.redirectURL %>">
                              <%= url.redirectURL %>
                            </a>
                          </td>

                          <!-- Status -->
                          <td>
                            <span class="status-badge status-<%= url.status %>">
                              <%= url.status.charAt(0).toUpperCase() + url.status.slice(1) %>
                            </span>
                          </td>

                          <!-- Clicks -->
                          <td class="click-count">
                            <%= url.totalClicks || 0 %>
                          </td>

                          <!-- Created -->
                          <td title="<%= url.createdAt.toLocaleString('en-IN', {
                                day: 'numeric',
                                month: 'long',
                                year: 'numeric',
                                hour: 'numeric',
                                minute: '2-digit',
                                hour12: true,
                                }) %>">
                            <%= url.createdAt.toLocaleDateString('en-IN', { day: 'numeric' , month: 'numeric' ,
                              year: 'numeric' , }) %>
                          </td>

                          <!-- Expires -->
                          <td title="<%= url.expiryDisplay.title %>">
                            <%= url.expiryDisplay.text %>
                          </td>

                          <!-- Actions -->
                          <td>
                            <div class="action-dropdown">
                              <button class="action-btn" type="button">
                                <i class="ri-more-2-fill"></i>
                              </button>

                              <div class="action-menu">
                                <button class="analytics-btn" data-shortid="<%= url.shortId %>">
                                  <i class="ri-line-chart-line"></i>
                                  Analytics
                                </button>

                                <button class="edit-link-btn" data-shortid="<%= url.shortId %>">
                                  <i class="ri-edit-line"></i>
                                  Edit Link
                                </button>

                                <button class="copy-btn" data-url="<%= `${baseUrl}/url/${url.shortId}` %>">
                                  <i class="ri-file-copy-line"></i>
                                  Copy Link
                                </button>

                                <% if (url.linkedQRId) { %>
                                  <button class="show-qr-tab-btn" data-qrid="<%= url.linkedQrSlug %>">
                                    <i class="ri-qr-code-line"></i>
                                    Show QR
                                  </button>
                                  <% } else { %>
                                    <button class="create-qr-btn" data-shortid="<%= url.shortId %>">
                                      <i class="ri-qr-code-line"></i>
                                      Create QR
                                    </button>
                                    <% } %>

                                      <hr />

                                      <button class="disable-btn" data-shortid="<%= url.shortId %>"
                                        data-disabled="<%= url.isDisabled %>"
                                        data-linked="<%= Boolean(url.linkedQRId) %>">
                                        <i class="ri-forbid-line"></i>
                                        <%= url.isDisabled ? "Enable" : "Disable" %>
                                      </button>

                                      <hr />

                                      <button class="delete-btn danger" data-shortid="<%= url.shortId %>"
                                        data-url="<%= url.redirectURL %>" data-linked="<%= Boolean(url.linkedQRId) %>">
                                        <i class="ri-delete-bin-line"></i>
                                        Delete
                                      </button>
                              </div>
                            </div>
                          </td>
                        </tr>
                        <% }) %>
                    </tbody>
                  </table>
                </div>

                <!-- urls links length shown -->
                <div class="table-header">
                  <span>
                    Showing
                    <%= startIndex %>–<%= endIndex %>
                        of
                        <%= totalUrls %>
                          links
                  </span>
                </div>

                <% const buildPageUrl=(pageNum)=> {
                  const params = new URLSearchParams();
                  if (filters.search) params.set('search', filters.search);
                  if (filters.status && filters.status !== 'all') params.set('status', filters.status);
                  if (filters.createdFrom) params.set('createdFrom', filters.createdFrom);
                  if (filters.createdTo) params.set('createdTo', filters.createdTo);
                  if (filters.expiry && filters.expiry !== 'all') params.set('expiry', filters.expiry);
                  if (filters.sortBy && filters.sortBy !== 'newest') params.set('sortBy', filters.sortBy);
                  params.set('page', pageNum);
                  return `/dashboard?${params.toString()}`;
                  };
                  %>
                  <!-- PAGINATION -->

                  <% if (totalPages> 1) { %>

                    <div class="pagination">
                      <% if (currentPage> 1) { %>

                        <a href="<%= buildPageUrl(currentPage - 1) %>" class="pagination-btn nav"> ← Prev </a>

                        <% } else { %>

                          <span class="pagination-btn nav disabled"> ← Prev </span>

                          <% } %>

                            <% const pages=new Set(); pages.add(1); pages.add(totalPages); for ( let
                              i=Math.max(1,currentPage-1); i <=Math.min(totalPages,currentPage+1); i++ ){ pages.add(i);
                              } const sorted=[...pages].sort((a,b)=>a-b); let prev=0; for(const p of
                              sorted){
                              if(p-prev>1){
                              %>

                              <span class="pagination-dots"> ··· </span>

                              <% } %>

                                <a href="<%= buildPageUrl(p) %>"
                                  class="pagination-btn <%= currentPage===p?'active':'' %>">
                                  <%= p %>
                                </a>

                                <% prev=p; } %>

                                  <% if(currentPage<totalPages){ %>

                                    <a href="<%= buildPageUrl(currentPage+1) %>" class="pagination-btn nav"> Next →
                                    </a>

                                    <% } else { %>

                                      <span class="pagination-btn nav disabled"> Next → </span>

                                      <% } %>
                    </div>

                    <% } %>

                      <% } else { %>

                        <div class="empty-state">
                          <% if (hasActiveFilters) { %>
                            <i class="ri-search-line"></i>
                            <h3>No results found</h3>
                            <% if (filters.search) { %>
                              <p>No links match "<strong>
                                  <%= filters.search %>
                                </strong>". Try a different search term or adjust your filters.</p>
                              <% } else { %>
                                <p>No links match the selected filters. Try adjusting or resetting them.</p>
                                <% } %>
                                  <% } else { %>
                                    <i class="ri-links-line"></i>
                                    <h3>No links yet</h3>
                                    <p>Create your first short URL to start managing links.</p>
                                    <% } %>
                        </div>

                        <% } %>
            </section>
  </div>

  <!-- FILTER MODAL -->
  <div id="filterModal" class="modal">
    <div class="modal-content modal-content--filter">
      <span class="close" data-close-modal>&times;</span>

      <div class="filter-content-header">
        <h3>Filters</h3>
      </div>

      <div class="filter-group">
        <label for="statusSelect">Status</label>
        <select name="status" id="statusSelect" form="urlToolbarForm">
          <option value="all" <%=filters.status==="all" ? "selected" : "" %>>All Status</option>
          <option value="active" <%=filters.status==="active" ? "selected" : "" %>>Active</option>
          <option value="disabled" <%=filters.status==="disabled" ? "selected" : "" %>>Disabled</option>
          <option value="expired" <%=filters.status==="expired" ? "selected" : "" %>>Expired</option>
        </select>
      </div>

      <div class="filter-group">
        <label>Created</label>
        <div class="date-range-row">
          <input type="date" name="createdFrom" value="<%= filters.createdFrom || '' %>" max="<%= todayStr %>"
            form="urlToolbarForm" />
          <span class="date-range-sep">to</span>
          <input type="date" name="createdTo" value="<%= filters.createdTo || '' %>" max="<%= todayStr %>"
            form="urlToolbarForm" />
        </div>
      </div>

      <div class="filter-group" id="expiryGroup">
        <label>Expiry</label>
        <div class="radio-group">
          <label class="radio-option">
            <input type="radio" name="expiry" value="all" form="urlToolbarForm" <%=(!filters.expiry ||
              filters.expiry==="all" ) ? "checked" : "" %>
            <%=filters.status==="expired" ? "disabled" : "" %> />
              <span>All</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="expiry" value="set" form="urlToolbarForm" <%=filters.expiry==="set" ? "checked"
              : "" %>
            <%=filters.status==="expired" ? "disabled" : "" %> />
              <span>Expiring</span>
          </label>
          <label class="radio-option">
            <input type="radio" name="expiry" value="never" form="urlToolbarForm" <%=filters.expiry==="never"
              ? "checked" : "" %>
            <%=filters.status==="expired" ? "disabled" : "" %> />
              <span>No expiration</span>
          </label>
        </div>
      </div>

      <div class="filter-group">
        <label>Sort by</label>
        <select name="sortBy" id="sortBySelect" form="urlToolbarForm">
          <option value="newest" <%=(!filters.sortBy || filters.sortBy==="newest" ) ? "selected" : "" %>>Newest first
          </option>
          <option value="oldest" <%=filters.sortBy==="oldest" ? "selected" : "" %>>Oldest first</option>
          <option value="mostClicked" <%=filters.sortBy==="mostClicked" ? "selected" : "" %>>Most clicked</option>
          <option value="leastClicked" <%=filters.sortBy==="leastClicked" ? "selected" : "" %>>Least clicked</option>
        </select>
      </div>

      <div class="filter-content-footer">
        <button type="button" class="clear-filters-btn" id="clearAllFiltersBtn">Clear all filters</button>
        <button type="submit" class="apply-filters-btn" form="urlToolbarForm">Apply Filters</button>
      </div>
    </div>
  </div>

  <!-- DELETE MODAL -->
  <div id="deleteModal" class="modal">
    <div class="modal-content modal-content--delete">
      <h3 id="deleteTitle">Delete Link?</h3>

      <p id="deleteMessage"></p>

      <div class="delete-actions">
        <button id="cancelDeleteBtn" data-close-modal type="button">Cancel</button>

        <button id="confirmDeleteBtn" type="button" class="danger">Delete</button>
      </div>
    </div>
  </div>

  <!-- DISABLE MODAL -->
  <div id="disableModal" class="modal">
    <div class="modal-content modal-content--delete">
      <h3 id="disableTitle">Disable Link?</h3>
      <p id="disableMessage"></p>
      <div class="delete-actions">
        <button id="cancelDisableBtn" data-close-modal type="button">Cancel</button>
        <button id="confirmDisableBtn" type="button">Confirm</button>
      </div>
    </div>
  </div>

  <!-- CREATE QR MODAL -->
  <div id="createQrModal" class="modal">
    <div class="modal-content modal-content--qr">
      <span class="close" data-close-modal>&times;</span>
      <h3>QR Code Created</h3>

      <div class="qr-loading-state" id="createQrLoadingState">
        <div id="createQrLoader" class="dots-loader">
          <span></span><span></span><span></span>
        </div>
        <p class="dots-loader-label" id="createQrLoaderLabel">Generating your QR code…</p>
      </div>

      <img id="createQrImage" src="" style="max-width: 220px; display: none;" />

      <div class="created-destination-row" id="createQrDestinationRow" style="display: none;">
        <i class="ri-arrow-right-up-line"></i>
        <span id="createQrDestination"></span>
      </div>

      <button id="shareCreatedQR" class="share-full-btn" style="display: none;">
        <i class="ri-share-line"></i>
      </button>
    </div>
  </div>

  <!-- SHORT LINK GENERATED MODAL (main dashboard) -->
  <div id="createdLinkModal" class="modal">
    <div class="modal-content modal-content--link">
      <span class="close" data-close-modal>&times;</span>
      <h3 link-modal>Short Link Created</h3>

      <div class="created-link-pill-row">
        <span class="created-link-pill">
          <i class="ri-link"></i>
          <span id="createdLinkUrl"></span>
        </span>
        <button class="created-link-copy-btn copy-btn" id="copyCreatedLinkBtn" title="Copy">
          <i class="ri-file-copy-line"></i>
        </button>
      </div>

      <div class="created-link-destination-row">
        <i class="ri-arrow-right-up-line"></i>
        <span id="createdLinkDestination"></span>
      </div>

      <button id="shareCreatedLink" class="share-full-btn">
        <i class="ri-share-line"></i>
      </button>
    </div>
  </div>

  <!-- BULK DELETE MODAL -->
  <div id="bulkDeleteModal" class="modal">
    <div class="modal-content modal-content--delete">
      <h3>Delete Selected Items?</h3>
      <p id="bulkDeleteMessage"></p>
      <div class="delete-actions">
        <button id="cancelBulkDeleteBtn" data-close-modal type="button">Cancel</button>
        <button id="confirmBulkDeleteBtn" type="button" class="danger">Delete</button>
      </div>
    </div>
  </div>

  <!-- BULK CREATION MODAL -->
  <div id="bulkUploadModal" class="modal">
  <div class="modal-content modal-content--bulk">
    <span class="close" data-close-modal>&times;</span>
    <h3>Bulk Create Links</h3>
    <p>Upload a CSV (columns: url, customAlias, title, expiration) or paste one URL per line.</p>

    <div class="bulk-tabs">
      <button type="button" class="bulk-tab-btn active" data-mode="file">Upload CSV</button>
      <button type="button" class="bulk-tab-btn" data-mode="paste">Paste URLs</button>
    </div>

    <div id="bulkFileSection">
      <input type="file" id="bulkFileInput" accept=".csv" />
    </div>
    <div id="bulkPasteSection" style="display:none;">
      <textarea id="bulkPasteInput" rows="6" placeholder="https://example.com&#10;https://example.org"></textarea>
    </div>

    <div id="bulkProgressSection" style="display:none;">
      <p id="bulkProgressText">0 / 0 processed</p>
      <div class="bulk-progress-bar"><div class="bulk-progress-fill" id="bulkProgressFill"></div></div>
      <a href="#" id="bulkResultsDownload" class="pagination-btn nav" style="display:none; text-decoration:none;">
        <i class="ri-download-2-line"></i> Download Results
      </a>
    </div>

    <div class="delete-actions">
      <button id="cancelBulkUploadBtn" data-close-modal type="button">Close</button>
      <button id="startBulkUploadBtn" type="button">Start Upload</button>
    </div>
  </div>
</div>

</body>

</html>