<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/images/icon.png" />
  <link rel="stylesheet" href="/css/pages/profile.css" />
  <script type="module" src="/js/main.js" defer></script>
  
  <title>Profile</title>
</head>

<body>
  <div class="profile-page">
    <div class="profile-topbar">
      <div>
        <h1>Profile</h1>
        <small>Manage your account, security and preferences</small>
      </div>
      <a href="/dashboard" class="back-link">
        <i class="ri-arrow-left-line"></i> Back to Dashboard
      </a>
    </div>

    <div id="profileToast" class="profile-toast" style="display:none;"></div>

    <!-- USERNAME -->
    <div class="form-group">
    <section class="card">
      <h2>Username</h2>
      <p class="card-sub">This is the name shown across your account.</p>
      <div class="field-row">
        <input type="text" id="usernameInput" value="<%= name %>" minlength="3" maxlength="50" />
        <button type="button" id="saveUsernameBtn" class="save-btn" disabled>Update Username</button>
      </div>
      <p class="field-error" id="usernameError"></p>
    </section>
    </div>

    <!-- PASSWORD -->
    <section class="card">
      <h2>Password</h2>
      <% if (hasLocalAuth) { %>
        <p class="card-sub">Enter your current password to set a new one.</p>
      <% } else { %>
        <p class="card-sub">Your account currently signs in with Google only. Set a password below to also enable email/password login.</p>
      <% } %>

      <% if (hasLocalAuth) { %>
        <div class="form-group">
          <label for="oldPasswordInput">Current Password</label>
          <div class="password-wrapper">
            <input type="password" id="oldPasswordInput" autocomplete="current-password" />
            <button type="button" id="toggleOldPassword" class="password-toggle-icon-btn" data-password-toggle="oldPasswordInput">
              <i class="ri-eye-line"></i>
            </button>
          </div>
        </div>
      <% } %>

      <div class="form-group">
        <label for="newPasswordInput">New Password</label>
        <div class="password-wrapper">
          <input type="password" id="newPasswordInput" autocomplete="new-password" />
          <button type="button" id="toggleNewPassword" class="password-toggle-icon-btn" data-password-toggle="newPasswordInput">
            <i class="ri-eye-line"></i>
          </button>
        </div>
      </div>

      <div class="form-group">
        <label>Confirm New Password</label>
        <div class="password-wrapper">
          <input type="password" id="confirmNewPasswordInput" autocomplete="new-password" />
          <button type="button" id="toggleConfirmNewPassword" class="password-toggle-icon-btn" data-password-toggle="confirmNewPasswordInput">
            <i class="ri-eye-line"></i>
          </button>
        </div>
      </div>

      <p class="card-note">Password must include uppercase, lowercase, number and one special character (@$!%*?&)</p>
      <button type="button" id="savePasswordBtn" class="save-btn" disabled style="margin-top: 10px;">Change Password</button>
      <p class="field-error" id="passwordError"></p>
    </section>

    <!-- DETAILS — USER only -->
    <% if (role === "USER") { %>
      <section class="card">
        <h2>Details</h2>
        <p class="card-sub">Optional — shown on your profile.</p>

        <div class="form-group">
          <label>Organization</label>
          <input type="text" id="organizationInput" maxlength="100" value="<%= organization %>" />
        </div>

        <div class="form-group">
          <label>Designation</label>
          <input type="text" id="designationInput" maxlength="100" value="<%= designation %>" />
        </div>

        <button type="button" id="saveDetailsBtn" class="save-btn" disabled>Update Details</button>
        <p class="field-error" id="detailsError"></p>
      </section>
    <% } %>

    <!-- DELETE ACCOUNT — USER only -->
    <% if (role === "USER") { %>
      <section class="card card-danger">
        <h2>Delete Account</h2>
        <p class="card-sub">Permanently delete your account and all associated data. This cannot be undone.</p>
        <button type="button" id="openDeleteAccountBtn" class="delete-btn">Delete Account</button>
      </section>
    <% } %>
  </div>

  <!-- DELETE ACCOUNT MODAL -->
  <div id="deleteAccountModal" class="modal">
    <div class="modal-content modal-content--delete">
      <h3>Delete your account?</h3>
      <p>This will permanently delete your account and all data associated with it. This action cannot be undone.</p>
      <p>Type <strong>CONFIRM DELETE</strong> below to proceed.</p>

      <div class="form-group">
        <input type="text" id="deleteAccountConfirmInput" placeholder="CONFIRM DELETE" autocomplete="off" />
      </div>

      <div class="delete-actions">
        <button id="cancelDeleteAccountBtn" data-close-modal type="button">Cancel</button>
        <button id="confirmDeleteAccountBtn" type="button" class="delete-btn" disabled>Delete Account</button>
      </div>
    </div>
  </div>
</body>
</html>